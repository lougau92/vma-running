{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VMA workout conversion draft 0.1",
  "description": "Reviewable source-preserving workout plans. Additional semantic constraints are documented in README.md. Draft: not the current app or Garmin payload.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "status": {
      "enum": [
        "workout",
        "no_workout",
        "unreadable"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "workouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workout"
      },
      "minItems": 0
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "sources",
    "workouts",
    "issues"
  ],
  "$defs": {
    "positiveBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "valueBounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "instruction",
            "route",
            "terrain",
            "technique",
            "coordination",
            "context"
          ]
        }
      },
      "required": [
        "text"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "blocking",
            "warning"
          ]
        },
        "code": {
          "enum": [
            "ambiguous",
            "conflicting",
            "missing",
            "inferred",
            "unresolved_reference"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "by": {
              "enum": [
                "reviewer",
                "source"
              ]
            }
          },
          "required": [
            "text",
            "by"
          ]
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "paths"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "email",
            "attachment",
            "review_feedback"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "sentAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "reference"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "specified",
            "not_specified",
            "explicitly_none"
          ]
        },
        "plan": {
          "$ref": "#/$defs/node"
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "specified"
              }
            }
          },
          "then": {
            "required": [
              "plan"
            ]
          },
          "else": {
            "not": {
              "required": [
                "plan"
              ]
            }
          }
        }
      ]
    },
    "end": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "time"
            },
            "seconds": {
              "$ref": "#/$defs/positiveBounds"
            }
          },
          "required": [
            "kind",
            "seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "distance"
            },
            "meters": {
              "$ref": "#/$defs/positiveBounds"
            }
          },
          "required": [
            "kind",
            "meters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "laps"
            },
            "count": {
              "$ref": "#/$defs/count"
            },
            "lapLengthMeters": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "count"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "repetitions"
            },
            "count": {
              "$ref": "#/$defs/count"
            }
          },
          "required": [
            "kind",
            "count"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "manual"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "event"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "description"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "any_of"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/end"
              },
              "minItems": 2
            }
          },
          "required": [
            "kind",
            "conditions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_of"
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/end"
              },
              "minItems": 2
            }
          },
          "required": [
            "kind",
            "conditions"
          ]
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "numeric"
            },
            "metric": {
              "enum": [
                "vma_percent",
                "speed_mps",
                "pace_seconds_per_km",
                "heart_rate_bpm",
                "heart_rate_max_percent",
                "power_watts",
                "cadence_spm",
                "rpe_0_10"
              ]
            },
            "value": {
              "$ref": "#/$defs/valueBounds"
            },
            "approximate": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "metric",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "effort"
            },
            "value": {
              "enum": [
                "easy",
                "steady",
                "hard",
                "submaximal",
                "all_out",
                "unspecified"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "value",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "progression"
            },
            "metric": {
              "enum": [
                "vma_percent",
                "speed_mps",
                "pace_seconds_per_km",
                "heart_rate_bpm",
                "heart_rate_max_percent",
                "power_watts",
                "cadence_spm",
                "rpe_0_10"
              ]
            },
            "from": {
              "type": "number",
              "minimum": 0
            },
            "to": {
              "type": "number",
              "minimum": 0
            },
            "distribution": {
              "enum": [
                "unspecified",
                "linear"
              ]
            },
            "scope": {
              "enum": [
                "within_step",
                "across_iterations"
              ]
            }
          },
          "required": [
            "kind",
            "metric",
            "from",
            "to",
            "distribution",
            "scope"
          ]
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "step"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "role": {
          "enum": [
            "effort",
            "recovery",
            "drill"
          ]
        },
        "end": {
          "$ref": "#/$defs/end"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 0
        },
        "movement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "active",
                "passive",
                "unspecified"
              ]
            },
            "allowed": {
              "type": "array",
              "items": {
                "enum": [
                  "run",
                  "jog",
                  "walk",
                  "stand",
                  "sit",
                  "other"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "mode"
          ]
        }
      },
      "required": [
        "kind",
        "role",
        "end"
      ]
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sequence"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "declaredDurationSeconds": {
          "$ref": "#/$defs/positiveBounds"
        }
      },
      "required": [
        "kind",
        "children"
      ]
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "repeat"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "body": {
          "$ref": "#/$defs/node"
        },
        "between": {
          "$ref": "#/$defs/node"
        }
      },
      "required": [
        "kind",
        "count",
        "body"
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choice"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "string",
                "minLength": 1
              },
              "plan": {
                "$ref": "#/$defs/node"
              }
            },
            "required": [
              "label",
              "plan"
            ]
          },
          "minItems": 2
        }
      },
      "required": [
        "kind",
        "reason",
        "options"
      ]
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "$ref": "#/$defs/repeat"
        },
        {
          "$ref": "#/$defs/choice"
        }
      ]
    },
    "workoutVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "warmup": {
          "$ref": "#/$defs/phase"
        },
        "main": {
          "$ref": "#/$defs/phase"
        },
        "cooldown": {
          "$ref": "#/$defs/phase"
        }
      },
      "required": [
        "label",
        "warmup",
        "main",
        "cooldown"
      ]
    },
    "workout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sport": {
          "enum": [
            "running"
          ]
        },
        "scheduledDate": {
          "type": "string",
          "format": "date"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          },
          "minItems": 0
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workoutVersion"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "sport",
        "versions"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "workout"
          }
        }
      },
      "then": {
        "properties": {
          "workouts": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "workouts": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
